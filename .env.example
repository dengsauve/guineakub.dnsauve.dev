# Server settings. Copy to root .env for local development; never commit .env.
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# OAuth web client ID is public configuration; ADMIN_GOOGLE_SUB is private config.
# Empty auth settings leave /health available and /ready unavailable.
GOOGLE_CLIENT_ID=
ADMIN_GOOGLE_SUB=
# Local single-process development only. Never use container disk for production.
SERVER_DATA_DIR=.local-data
# Existing Azure resources only; leave blank for local development.
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=
# Public frontend settings belong in apps/web/.env.local when Phase 4 is built.
# Never put session credentials, private subjects or storage credentials in VITE_*.
VITE_API_ORIGIN=http://localhost:3000
VITE_GOOGLE_CLIENT_ID=
